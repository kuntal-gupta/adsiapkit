{
    "name": "AdsIAPKit.Runtime",
    "rootNamespace": "AdsIAPKit",
    "references": [
        "Unity.Purchasing",
        "Unity.Purchasing.Stores",
        "Unity.Advertisement.IosSupport",
        "UnityEngine.UI",
        "Unity.TextMeshPro"
    ],
    "includePlatforms": [],
    "excludePlatforms": [],
    "allowUnsafeCode": false,
    "overrideReferences": false,
    "precompiledReferences": [],
    "autoReferenced": true,
    "defineConstraints": [],
    "versionDefines": [
        { "name": "com.unity.purchasing",       "expression": "5.0.0", "define": "UNITY_IAP_ENABLED" },
        { "name": "com.google.ads.mobile",      "expression": "1.0.0", "define": "ADMOB_ENABLED" },
        { "name": "com.unity.ads",              "expression": "4.0.0", "define": "UNITY_ADS_ENABLED" },
        { "name": "com.applovin.mediation.ads", "expression": "1.0.0", "define": "APPLOVIN_ENABLED" },
        { "name": "com.unity.ads.ios-support",  "expression": "1.0.0", "define": "ATT_SUPPORT_ENABLED" },
        { "name": "com.unity.ugui",             "expression": "1.0.0", "define": "ADSIAPKIT_UGUI" },
        { "name": "com.unity.ugui",             "expression": "2.0.0", "define": "ADSIAPKIT_TMP" },
        { "name": "com.unity.textmeshpro",      "expression": "3.0.0", "define": "ADSIAPKIT_TMP" }
    ],
    "noEngineReferences": false
}
